<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#0b0e14"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TV Guard"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#94a3b8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Điều khiển TV qua Internet (Cloud)"/>
            </LinearLayout>
            <Button
                android:id="@+id/btnToggleConfig"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#38bdf8"
                android:background="@drawable/btn_secondary"
                android:paddingLeft="10dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="CÀI ĐẶT"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cardConfig"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#38bdf8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="⚙️ CẤU HÌNH"/>
            <TextView
                android:id="@+id/urlTv"
                android:textSize="13sp"
                android:textColor="#cbd5e1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text=""/>
            <Button
                android:id="@+id/btnChangeUrl"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/btn_secondary"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="8dp"
                android:text="Thay đổi URL"/>
            <EditText
                android:id="@+id/urlEt"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:textColorHint="#64748b"
                android:background="@drawable/input_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                android:singleLine="true"
                android:hint="URL mới (để trống = dùng URL mặc định)"/>
            <Button
                android:id="@+id/urlSaveBtn"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/btn_primary"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                android:text="Lưu URL"/>
            <TextView
                android:id="@+id/codeTv"
                android:textSize="13sp"
                android:textColor="#cbd5e1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text=""/>
            <Button
                android:id="@+id/btnChangeCode"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/btn_secondary"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="8dp"
                android:text="Thay đổi mã TV"/>
            <EditText
                android:id="@+id/codeEt"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:textColorHint="#64748b"
                android:background="@drawable/input_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                android:singleLine="true"
                android:hint="Mã TV mới (a-z, 0-9; để trống = dùng mã mặc định)"/>
            <Button
                android:id="@+id/codeSaveBtn"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/btn_primary"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Lưu mã TV"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#10b981"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="TRẠNG THÁI TV"/>
            <TextView
                android:id="@+id/statusTv"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TV: chưa có dữ liệu"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#f472b6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="CHỤP MÀN HÌNH TV"/>
            <Button
                android:id="@+id/btnShot"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/btn_primary"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Chụp ngay"/>
            <ImageView
                android:id="@+id/shotIv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:background="@drawable/input_bg"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#10b981"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="ĐIỀU KHIỂN TỨC THÌ"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/btnLock"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:background="@drawable/btn_danger"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginRight="6dp"
                    android:layout_weight="1"
                    android:text="Khóa ngay"/>
                <Button
                    android:id="@+id/btnUnlock"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:background="@drawable/btn_secondary"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:text="Mở khóa"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#f59e0b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="HẸN GIỜ XEM TV"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#cbd5e1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Số phút"/>
            <EditText
                android:id="@+id/minEt"
                android:textSize="15sp"
                android:textColor="#ffffff"
                android:textColorHint="#64748b"
                android:background="@drawable/input_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:hint="Số phút"
                android:text="60"
                android:inputType="number"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#cbd5e1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Khi hết giờ:"/>
            <RadioGroup
                android:id="@+id/modeRg"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">
                <RadioButton
                    android:id="@+id/rbBlack"
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:checked="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Màn hình đen"/>
                <RadioButton
                    android:id="@+id/rbImage"
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:layout_marginTop="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khung ảnh (ảnh đã chọn)"/>
                <RadioButton
                    android:id="@+id/rbShutdown"
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:layout_marginTop="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tắt nguồn TV (shutdown, như bấm phím Nguồn)"/>
            </RadioGroup>
            <Button
                android:id="@+id/btnSetTimer"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/btn_primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:text="Đặt giờ"/>
            <Button
                android:id="@+id/btnCancelTimer"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/btn_secondary"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Hủy hẹn giờ (không giới hạn thời gian)"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#f59e0b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="ÂM LƯỢNG TV"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/btnVolUp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:background="@drawable/btn_primary"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginRight="6dp"
                    android:layout_weight="1"
                    android:text=" + Tăng "/>
                <Button
                    android:id="@+id/btnVolDown"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:background="@drawable/btn_primary"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:text=" - Giảm "/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#f472b6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="GỬI TIN NHẮN LÊN MÀN HÌNH TV"/>
            <EditText
                android:id="@+id/msgEt"
                android:textSize="15sp"
                android:textColor="#ffffff"
                android:textColorHint="#64748b"
                android:background="@drawable/input_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="top|start"
                android:minLines="3"
                android:maxLines="5"
                android:maxLength="300"
                android:inputType="textMultiLine|textCapSentences"
                android:hint="Nhập tin nhắn (tối đa 300 ký tự)"/>
            <TextView
                android:id="@+id/msgCountTv"
                android:textSize="12sp"
                android:textColor="#94a3b8"
                android:gravity="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="0/300"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <Button
                    android:id="@+id/btnSendMsg"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:background="@drawable/btn_primary"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginRight="6dp"
                    android:layout_weight="1"
                    android:text="Gửi tin nhắn"/>
                <Button
                    android:id="@+id/btnHideMsg"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:background="@drawable/btn_secondary"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:text="Ẩn tin nhắn"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#94a3b8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tin nhắn hiện trên màn hình TV cho đến khi bấm Back hoặc Home trên điều khiển TV."/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#a855f7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="GỬI ẢNH LÊN MÀN HÌNH TV"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#cbd5e1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Hiển thị bao nhiêu giây (0 = đến khi ẩn)"/>
            <EditText
                android:id="@+id/secEt"
                android:textSize="15sp"
                android:textColor="#ffffff"
                android:textColorHint="#64748b"
                android:background="@drawable/input_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:text="30"
                android:inputType="number"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <Button
                    android:id="@+id/btnPickSend"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:background="@drawable/btn_primary"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginRight="6dp"
                    android:layout_weight="1"
                    android:text="Chọn ảnh và gửi"/>
                <Button
                    android:id="@+id/btnHideImg"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:background="@drawable/btn_secondary"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:text="Ẩn ảnh trên TV"/>
            </LinearLayout>
            <Button
                android:id="@+id/btnPickLock"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/btn_secondary"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Chọn ảnh làm khung khóa"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#38bdf8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="ICON APP TV"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/btnHideIcon"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:background="@drawable/btn_secondary"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginRight="6dp"
                    android:layout_weight="1"
                    android:text="Ẩn icon app TV"/>
                <Button
                    android:id="@+id/btnShowIcon"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:background="@drawable/btn_secondary"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:text="Hiện icon app TV"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#94a3b8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Cài đặt TV luôn mở, không bị chặn."/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#38bdf8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="NHẬT KÝ XEM TV HÔM NAY"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#94a3b8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="TV được Mở / Tắt lúc nào trong ngày hôm nay:"/>
            <TextView
                android:id="@+id/watchlogTv"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hôm nay chưa có lịch sử Mở / Tắt TV"/>
        </LinearLayout>
        <TextView
            android:id="@+id/msgTv"
            android:textSize="13sp"
            android:textColor="#64748b"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text=""/>
        <Button
            android:id="@+id/btnSwitchMode"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:background="@drawable/btn_secondary"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="20dp"
            android:text="Đổi chế độ"/>
    </LinearLayout>
</ScrollView>
