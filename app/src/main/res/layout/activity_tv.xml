<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#0b0e14"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TV Guard"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#94a3b8"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Đang chạy nền để nhận lệnh điều khiển từ điện thoại"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp">
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#10b981"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="TRẠNG THÁI TV"/>
            <TextView
                android:id="@+id/info"
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#38bdf8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="⚙️ CẤU HÌNH (TV)"/>
            <TextView
                android:id="@+id/urlTv"
                android:textSize="14sp"
                android:textColor="#cbd5e1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text=""/>
            <Button
                android:id="@+id/btnChangeUrl"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/btn_secondary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:text="Thay đổi URL"/>
            <EditText
                android:id="@+id/urlEt"
                android:textSize="15sp"
                android:textColor="#ffffff"
                android:textColorHint="#64748b"
                android:background="@drawable/input_bg"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                android:singleLine="true"
                android:hint="URL mới (để trống = dùng URL mặc định)"/>
            <Button
                android:id="@+id/urlSaveBtn"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/btn_primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone"
                android:text="Lưu URL"/>
            <TextView
                android:id="@+id/codeTv"
                android:textSize="14sp"
                android:textColor="#cbd5e1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text=""/>
            <Button
                android:id="@+id/btnChangeCode"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/btn_secondary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:text="Thay đổi mã TV"/>
            <EditText
                android:id="@+id/codeEt"
                android:textSize="15sp"
                android:textColor="#ffffff"
                android:textColorHint="#64748b"
                android:background="@drawable/input_bg"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                android:singleLine="true"
                android:hint="Mã TV mới (a-z, 0-9; để trống = dùng mã mặc định)"/>
            <Button
                android:id="@+id/codeSaveBtn"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/btn_primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Lưu mã TV"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#f59e0b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="CÀI ĐẶT VÀ CHẠY NỀN"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#10b981"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="Cài đặt TV luôn mở, không bị chặn."/>
            <Button
                android:id="@+id/btnAcc"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/btn_primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:text="Mở cài đặt Trợ năng"/>
            <Button
                android:id="@+id/btnPowerCheck"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/btn_secondary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:text="Kiểm tra quyền tắt nguồn (ADB nội bộ)"/>
            <Button
                android:id="@+id/btnForceOff"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/btn_secondary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:text=""/>
            <Button
                android:id="@+id/btnIcon"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/btn_secondary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:text=""/>
            <Button
                android:id="@+id/btnMinimize"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/btn_primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:text="Thu nhỏ app (dịch vụ vẫn chạy nền)"/>
            <Button
                android:id="@+id/btnSwitchMode"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/btn_secondary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Đổi chế độ"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="#94a3b8"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Mở lại app khi icon bị ẩn: adb shell am start -n vn.herotran.tvcontrol/.MainActivity"/>
    </LinearLayout>
</ScrollView>
